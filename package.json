{
  "name": "acepilot147-extensions",
  "version": "1.3.0",
  "description": "acepilot147's extensions for Paperback 0.8, forked from AthK's extension of Comix",
  "main": "index.js",
  "repositoryName": "AceExtensions",
  "author": "acepilot147",
  "scripts": {
    "bundle": "paperback bundle --folder 0.8",
    "serve": "paperback serve",
    "refresh:comix": "node -r ts-node/register/transpile-only experiment/RefreshComixBundle.ts",
    "validate:comix": "node experiment/crypto-pipeline/validate.mjs",
    "crypto:pipeline": "node experiment/crypto-pipeline/run.mjs",
    "test": "paperback test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:keys": "node --test experiment/live/test-polyfills.mjs experiment/live/test-crypto-keys.mjs experiment/live/test-key-manager.mjs experiment/live/test-key-retry.mjs experiment/live/test-apicore-guards.mjs",
    "test:keys:e2e": "node experiment/live/test-live-keys.mjs",
    "verify:keys": "node experiment/live/verify-keys.mjs",
    "comix:capture": "node experiment/live/capture.mjs",
    "comix:keys": "node experiment/live/extract-keys.mjs && node experiment/crypto-pipeline/generate.mjs",
    "comix:e2e": "node experiment/live/e2e.mjs"
  },
  "devDependencies": {
    "@paperback/toolchain": "^0.8.0-alpha.47",
    "@paperback/types": "^0.8.0-alpha.47",
    "@typescript-eslint/eslint-plugin": "^4.25.0",
    "@typescript-eslint/parser": "^4.25.0",
    "eslint": "^7.27.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@paperback/types": "^0.8.0-alpha.47",
    "cheerio": "^1.0.0-rc.12"
  }
}
